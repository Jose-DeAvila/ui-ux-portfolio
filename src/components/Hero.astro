---
import { Image } from "astro:assets";
import { heroPills } from "../data/content";
import avatar from "../assets/portfolio/foto_perfil.png";
---

<section class="hero-section" id="inicio">
	<div class="hero-container">
		<div class="hero-content">
			<div class="status-badge">
				<span class="badge-icon">📍</span> Santo Domingo, R.D. · Disponible para proyectos
			</div>
			<h1>Todo proyecto inicia con una <span class="highlight-name">buena idea</span> ✨</h1>
			<p class="hero-lead">
				Diseño marcas auténticas e interfaces funcionales con intención. Cada proyecto es una oportunidad para conectar
				ideas con personas a través de experiencias digitales claras, estéticas y memorables.
			</p>
			<div class="hero-actions">
				<a href="#proyectos" class="btn btn-dark">Ver proyectos &rarr;</a>
				<a href="#contacto" class="btn btn-outline">¡Hablemos! 👋</a>
			</div>
		</div>

		<div class="hero-visual">
			<span class="decor-star">★</span>
			<div class="hero-image-wrapper">
				<Image
					src={avatar}
					alt="Maitee Batista - Diseñadora UI/UX"
					class="hero-avatar"
					widths={[400, 800]}
					sizes="(max-width: 768px) 80vw, 400px"
					loading="eager"
				/>
			</div>

			{
				heroPills.map((pill) => (
					<div class={`floating-pill ${pill.className}`}>
						<span class={`pill-dot ${pill.dot}`} /> {pill.label}
					</div>
				))
			}
		</div>
	</div>
</section>
