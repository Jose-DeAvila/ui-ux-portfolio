---
/** Fondo mágico decorativo y contenedor de destellos del mouse. */
---

<div id="sparkle-container"></div>

<div class="cloud-bg" aria-hidden="true">
	<div class="pastel-orb orb-pink"></div>
	<div class="pastel-orb orb-lavender"></div>
	<div class="pastel-orb orb-mint"></div>

	<span class="celestial moon-crescent-1">🌙</span>
	<span class="celestial moon-full">🌕</span>
	<span class="celestial moon-crescent-2">🌘</span>
	<span class="celestial planet-saturn">🪐</span>

	<span class="celestial star star-glow star-1">✦</span>
	<span class="celestial star star-soft star-2">★</span>
	<span class="celestial star star-gold star-3" title="Snitch Dorada">⚡</span>
	<span class="celestial star star-lilac star-4">✦</span>
	<span class="celestial star star-soft star-5">★</span>
	<span class="celestial star star-glow star-6">✧</span>
	<span class="celestial star star-pink star-7">✦</span>
	<span class="celestial star star-gold star-8">★</span>

	<span class="sparkle-point sp-1"></span>
	<span class="sparkle-point sp-2"></span>
	<span class="sparkle-point sp-3"></span>
	<span class="sparkle-point sp-4"></span>
	<span class="sparkle-point sp-5"></span>

	<div class="dream-cloud cloud-1"></div>
	<div class="dream-cloud cloud-2"></div>
</div>
