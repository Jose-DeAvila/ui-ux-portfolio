---
import SectionHeader from "./SectionHeader.astro";
import { certifications, favoriteTools } from "../data/content";
---

<section class="about-section reveal" id="sobre-mi">
	<SectionHeader
		tag="✦ El ADN de mi trabajo ✦"
		title="Sobre mí en cápsulas ✨"
		subtitle="Menos ruido, más intención. Así es como pienso y diseño."
	/>

	<div class="about-bento-grid">
		<div class="bento-box bento-quote">
			<span class="bento-badge">💖 Mi Credo</span>
			<blockquote>
				“El diseño no se trata solo de cómo se ve o se siente, sino de <em>cómo transforma</em> el día a día de las
				personas.”
			</blockquote>
			<span class="quote-author">— Frank Chimero</span>
		</div>

		<div class="bento-box bento-formula">
			<span class="bento-badge">🧠 Enfoque</span>
			<div class="formula-pills">
				<span class="f-item">Estrategia</span>
				<span class="f-plus">+</span>
				<span class="f-item">Empatía</span>
				<span class="f-plus">=</span>
				<span class="f-result">Experiencias Claras ✨</span>
			</div>
		</div>

		<div class="bento-box bento-certs">
			<div class="bento-head">
				<span class="bento-badge">🎓 Formación &amp; UX</span>
				<small>Verificadas</small>
			</div>
			<div class="cert-chips-row">
				{
					certifications.map((cert) => (
						<div class="cert-stamp">
							<span class="stamp-icon">{cert.icon}</span>
							<div>
								<strong>{cert.title}</strong>
								<small>{cert.detail}</small>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<div class="bento-box bento-stack">
			<span class="bento-badge">⚡ Mis Favoritas</span>
			<div class="quick-stack-tags">
				{
					favoriteTools.map((tool) => (
						<span class="stack-tag">
							<i class={`st-dot ${tool.dot}`} /> {tool.label}
						</span>
					))
				}
			</div>
		</div>

		<div class="bento-box bento-location">
			<div class="location-art">⚡🪄</div>
			<div>
				<strong>De Muggles a Usuarios Felices</strong>
				<p>
					Potterhead declarada. Diseñar interfaces es mi versión moderna de la magia: creo flujos digitales tan
					fluidos y encantadores que parecen funcionar con un simple movimiento de varita.
				</p>
			</div>
		</div>
	</div>
</section>
