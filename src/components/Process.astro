---
import SectionHeader from "./SectionHeader.astro";
import { processSteps } from "../data/content";
---

<section class="process-section reveal" id="proceso">
	<SectionHeader
		tag="✦ Estrategia & Creatividad ✦"
		title="Mi Proceso de Trabajo"
		subtitle="Donde la estrategia se encuentra con la creatividad para lograr resultados excepcionales."
		subtitleClass="process-subtitle"
	/>
	<ol class="process-flow" aria-label="Etapas de mi proceso de diseño">
		{
			processSteps.map((step, index) => (
				<li class={`process-step ${step.className}`}>
					<span class="process-marker">{String(index + 1).padStart(2, "0")}</span>
					<div class="process-copy">
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
